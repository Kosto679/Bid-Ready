# Set to 1 to skip live TED calls (use data/tender-demo/ted-cache)
BIDREADY_OFFLINE=0

# Gemini on Vertex AI (the contest's Google Cloud project): profile reading, CPV codes, letter rewrite, model check.
# Leave GOOGLE_CLOUD_PROJECT empty to run without it (rule-based fallbacks).
# Auth: run `gcloud auth application-default login` (or set GOOGLE_APPLICATION_CREDENTIALS to a service-account file outside the repo).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Sponsor integrations (optional; each falls back gracefully when unset)
# Firecrawl: read a company website during onboarding. https://firecrawl.dev
FIRECRAWL_API_KEY=
# Oumi decision model (Iris): an independent second checker. Project ID is shown in the Oumi workspace.
OUMI_API_KEY=
OUMI_PROJECT_ID=
OUMI_MODEL=iris-latest
